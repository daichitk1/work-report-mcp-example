# Repository-root .env is read by the API dev/start commands.
PORT=8787

# Override only when the MCP Apps UI bundle is in a non-default location.
# WORK_REPORT_UI_HTML_PATH=apps/web/dist/index.html

# Placeholders only. Configure your own Auth0 tenant and HTTPS MCP resource.
# Never store access tokens, refresh tokens or client secrets here.
WORK_REPORT_AUTH_ISSUER=https://your-tenant.auth0.com/
WORK_REPORT_AUTH_AUDIENCE=https://mcp.example/mcp
WORK_REPORT_MCP_RESOURCE_URL=https://mcp.example/mcp

# Override only when the issuer does not use the standard JWKS endpoint.
# WORK_REPORT_AUTH_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
