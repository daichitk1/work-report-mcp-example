    "jose": "6.2.12",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
